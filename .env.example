# Token của con bot bạn tạo từ BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Token API của tài khoản Railway (Vào Account Settings -> API Tokens để tạo)
RAILWAY_API_TOKEN=your_railway_api_token_here

# ID của Environment (Môi trường, thường là "production")
# Khi vào trang project Railway, bạn sẽ thấy UUID này trên thanh địa chỉ URL, hoặc có thể dùng Command Line để lấy
RAILWAY_ENVIRONMENT_ID=your_environment_id_here

# ID của Service (Ứng dụng Web trong Project của bạn)
# Bạn click vào ứng dụng trong Railway, nhìn vào Settings sẽ thấy Service ID
RAILWAY_SERVICE_ID=your_service_id_here

# Secret d? b?o v? Cron job (t? t?o m?t chu?i ng?u nhi�n)
CRON_SECRET=chuoi_bi_mat_cua_ban
